// OMO configuration
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "[opencode]": {
    "agents": {
      "sisyphus": {
        "model": "anthropic/claude-opus-5-5",
        "ultrawork": {
          "model": "anthropic/claude-opus-5-5",
          "reasoning": "max"
        },
        "reasoning": "max"
      },
      "hephaestus": {
        "model": "anthropic/claude-opus-5-5",
        "reasoning": "medium"
      },
      "oracle": {
        "model": "anthropic/claude-opus-5-5",
        "reasoning": "max"
      },
      "librarian": {
        "model": "anthropic/claude-haiku-5-5"
      },
      "explore": {
        "model": "anthropic/claude-haiku-5-5"
      },
      "multimodal-looker": {
        "model": "anthropic/claude-opus-5-5",
        "reasoning": "medium"
      },
      "prometheus": {
        "model": "anthropic/claude-opus-5-5",
        "reasoning": "max"
      },
      "metis": {
        "model": "anthropic/claude-opus-5-5",
        "reasoning": "max"
      },
      "momus": {
        "model": "anthropic/claude-opus-5-5",
        "reasoning": "max"
      },
      "atlas": {
        "model": "anthropic/claude-sonnet-5-5"
      },
      "sisyphus-junior": {
        "model": "anthropic/claude-opus-5-5",
        "reasoning": "max"
      }
    },
    "categories": {
      "visual-engineering": {
        "model": "anthropic/claude-opus-5-5",
        "reasoning": "max"
      },
      "ultrabrain": {
        "model": "anthropic/claude-opus-5-5",
        "reasoning": "xhigh"
      },
      "deep": {
        "model": "anthropic/claude-opus-5-5",
        "reasoning": "medium"
      },
      "artistry": {
        "model": "anthropic/claude-opus-5-5",
        "reasoning": "max"
      },
      "quick": {
        "model": "anthropic/claude-sonnet-5-5"
      },
      "unspecified-low": {
        "model": "anthropic/claude-sonnet-5-5"
      },
      "unspecified-high": {
        "model": "anthropic/claude-opus-5-5"
      },
      "writing": {
        "model": "anthropic/claude-sonnet-5-5"
      }
    },
    "tui": {
      "sidebar": {
        "enabled": false
      }
    }
  }
}
