{
  "autoupdate": false,
  "plugin": [
    "opencode-gemini-auth@latest",
    "opencode-claude-auth",
    "opencode-wakatime",
    "@mohak34/opencode-notifier@latest",
    "omo-olympus@latest",
    "oh-my-openagent@latest"
  ],
  "mcp": {
    "jira": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "enabled": true
    },
    "datadog": {
      "type": "remote",
      "url": "https://mcp.datadoghq.com/api/unstable/mcp-server/mcp?toolsets=core,dashboards",
      "enabled": true
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "enabled": true
    },
    "montage": {
      "type": "remote",
      "url": "https://montage.wanted.co.kr/mcp",
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["pnpm", "dlx", "@modelcontextprotocol/server-github"],
      "enabled": true,
      "timeout": 30000,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{file:~/.config/opencode/.github-token}"
      }
    }
  },
  "permission": {
    "mcp": {
      "datadog": "ask"
    }
  },
  "$schema": "https://opencode.ai/config.json"
}
